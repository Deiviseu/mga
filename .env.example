# Endpoint que recebe os formulários (contato, orçamento, denúncia) via POST JSON.
# Ex.: Formspree, Make/Zapier webhook, API do CRM (RD Station, HubSpot) ou função serverless própria.
PUBLIC_FORM_ENDPOINT=
# Endpoint separado para o Canal de Denúncia (recomendado: ferramenta de compliance terceirizada)
PUBLIC_WHISTLEBLOWER_ENDPOINT=
# Só carregam após consentimento de cookies
PUBLIC_GA_ID=
PUBLIC_FB_PIXEL_ID=
# 1 = baixa e converte imagens remotas (mga.com.br/storage) para AVIF/WebP no build
OPTIMIZE_REMOTE_IMAGES=0
