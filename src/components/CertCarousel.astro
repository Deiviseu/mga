---
import type { Lang } from '../i18n/routes';
import { useT, tr } from '../i18n/ui';
import { CERTIFICATES } from '../lib/content';
interface Props { lang: Lang; id?: string }
const { lang, id = 'certs' } = Astro.props;
const t = useT(lang);
---
<div class="certs" data-certs aria-roledescription="carousel" role="region" aria-label={t('certs.title')} id={id}>
  <div class="certs__viewport" data-viewport>
    <ul class="certs__track" role="list">
      {CERTIFICATES.items.map((c: any) => {
        const inner = (
          <>
            <span class="seal" aria-hidden="true">
              {c.logo ? <img src={c.logo} alt="" width="96" height="96" loading="lazy" /> : <span class="seal__txt">{c.name}</span>}
            </span>
            <span class="certs__name">{c.name}</span>
            <span class="certs__scope">{tr(c.scope, lang)}</span>
            <span class="label">{c.pdf ? t('certs.open') : t('certs.pending')}</span>
          </>
        );
        return (
          <li class="certs__slide">
            {c.pdf ? <a class="certs__card" href={c.pdf} target="_blank" rel="noopener">{inner}</a> : <div class="certs__card is-pending">{inner}</div>}
          </li>
        );
      })}
    </ul>
  </div>
  <div class="certs__nav">
    <button type="button" class="certs__btn" data-prev aria-label={t('certs.prev')}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></button>
    <button type="button" class="certs__btn" data-next aria-label={t('certs.next')}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></button>
  </div>
</div>
<script>
  import EmblaCarousel from 'embla-carousel';
  document.querySelectorAll<HTMLElement>('[data-certs]').forEach((root) => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const embla = EmblaCarousel(root.querySelector<HTMLElement>('[data-viewport]')!, { align: 'start', containScroll: 'trimSnaps', duration: reduce ? 0 : 25 });
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const sync = () => { prev.disabled = !embla.canScrollPrev(); next.disabled = !embla.canScrollNext(); };
    prev.addEventListener('click', () => embla.scrollPrev());
    next.addEventListener('click', () => embla.scrollNext());
    embla.on('select', sync).on('reInit', sync);
    sync();
    // Foco por teclado leva o slide para a área visível
    embla.slideNodes().forEach((s, i) => s.addEventListener('focusin', () => embla.scrollTo(i)));
  });
</script>
<style>
  .certs__viewport { overflow: hidden; }
  .certs__track { display: flex; list-style: none; margin: 0 0 0 calc(var(--space-4) * -1); padding: 0; touch-action: pan-y pinch-zoom; }
  .certs__slide { flex: 0 0 75%; min-width: 0; padding-left: var(--space-4); }
  @media (min-width: 600px) { .certs__slide { flex-basis: 40%; } }
  @media (min-width: 1000px) { .certs__slide { flex-basis: 22%; } }
  .certs__card { display: grid; gap: var(--space-2); height: 100%; padding: var(--space-5); border: 1px solid var(--color-line); background: var(--white); text-decoration: none; color: var(--ink); border-radius: var(--radius-sm); }
  a.certs__card:hover { border-color: var(--ink); }
  a.certs__card .label { color: var(--color-primary); }
  .seal { width: 88px; height: 88px; border-radius: 50%; border: 1.5px solid var(--ink); display: grid; place-items: center; margin-bottom: var(--space-3); position: relative; }
  .seal::after { content: ''; position: absolute; inset: 5px; border-radius: 50%; border: 1px dashed var(--steel-300); }
  .seal__txt { font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; text-align: center; line-height: 1; padding: 0 10px; }
  .seal img { width: 100%; height: 100%; object-fit: contain; border-radius: 50%; }
  .certs__name { font-family: var(--font-display); font-size: 1.375rem; font-weight: 600; }
  .certs__scope { font-size: var(--fs-sm); color: var(--color-muted); }
  .certs__nav { display: flex; gap: var(--space-1); justify-content: flex-end; margin-top: var(--space-4); }
  .certs__btn { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--color-line-strong); background: var(--white); border-radius: var(--radius); cursor: pointer; }
  .certs__btn:disabled { opacity: 0.4; cursor: default; }
  .certs__btn svg { width: 16px; }
</style>
