---
import type { Lang } from '../i18n/routes';
import { useT, tr } from '../i18n/ui';
import { directionsUrl, hasPhone, unitAddress, type Unit } from '../lib/content';
interface Props { unit: Unit; lang: Lang; index?: number; selectable?: boolean }
const { unit: u, lang, index, selectable = false } = Astro.props;
const t = useT(lang);
---
<article class="unit" data-unit={u.id} data-lat={u.geo.lat} data-lng={u.geo.lng}>
  <p class="label">{index !== undefined && <span class="num">{String(index + 1).padStart(2, '0')} · </span>}{u.city && !u.city.startsWith('TODO') ? `${u.city.toUpperCase()} / ${u.state}` : u.state}</p>
  <h3>{tr(u.name, lang)}</h3>
  <p class="unit__role">{tr(u.role, lang)}</p>
  <p class="unit__addr">{unitAddress(u) || <span class="todo-flag">{t('common.todo')}</span>}</p>
  <div class="unit__links">
    {hasPhone(u.phone)
      ? <a href={`tel:${u.phone}`} class="num">{u.phoneDisplay}</a>
      : <span class="todo-flag">{t('units.phoneTodo')}</span>}
    <a href={directionsUrl(u)} target="_blank" rel="noopener" class="link-arrow">{t('cta.directions')}</a>
    {selectable && <button type="button" class="unit__show" data-show-unit={u.id} aria-pressed="false">{t('units.show')}</button>}
  </div>
</article>
<style>
  .unit { padding: var(--space-5) 0; border-top: 1px solid var(--color-line-strong); display: grid; gap: var(--space-1); }
  .unit h3 { margin: var(--space-1) 0 0; }
  .unit__role { color: var(--steel-600); font-size: var(--fs-sm); margin: 0; }
  .unit__addr { margin: var(--space-2) 0; font-size: var(--fs-sm); }
  .unit__links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); align-items: center; font-size: var(--fs-sm); }
  .unit__links a { min-height: 32px; display: inline-flex; align-items: center; }
  .unit__show { background: none; border: 1px solid var(--color-line-strong); border-radius: var(--radius-sm); min-height: 32px; padding: 0 0.7rem; cursor: pointer; font-size: var(--fs-sm); }
  .unit__show[aria-pressed='true'] { background: var(--ink); color: var(--white); border-color: var(--ink); }
</style>
